{
  "name": "dsh-magical-lowcode-project",
  "version": "0.2.16",
  "description": "DeepSeek Harness 低代码工程模式插件：工作区项目文件树、推送状态(push status)、脚本运行、页面预览装配、推送前静态校验(lint) 的 host RPC，加插件自带 Web 面板（设置页 / 侧栏浮层 / 会话页签三处入口，受工程模式开关控制，入口层中英双语）与 Agent 预设包(.dshpreset)导入导出端点。Low-code project mode plugin for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "低代码工程模式",
    "summary": "把 MagicalCoder 风格低代码工程目录搬进 DSH：项目文件树、page/api 推送状态、source-*.js 脚本运行、页面预览沙箱装配、推送前静态校验(V1.01~V1.06)，以及 Agent 预设包 .dshpreset 的导入导出。",
    "categories": [
      "开发工具",
      "Web UI",
      "低代码"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:desktopProjectController"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-0",
      "node": "^22.19.0 || >=24.0.0"
    },
    "permissions": {
      "filesystem": [
        "registered-workspaces"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "lowcode",
    "low-code",
    "magicalcoder",
    "project-mode",
    "workspace",
    "lint",
    "preset"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzqzm/dsh-magical-lowcode-project.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.0-0",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/verify.mjs && node test/client-stub-check.mjs && node test/render-check.mjs && node test/preset-check.mjs && node test/env-check.mjs && node test/search-check.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:client": "node test/client-stub-check.mjs",
    "test:render": "node test/render-check.mjs",
    "test:preset": "node test/preset-check.mjs",
    "test:env": "node test/env-check.mjs",
    "test:search": "node test/search-check.mjs",
    "prepublishOnly": "node test/verify.mjs && node test/client-stub-check.mjs && node test/render-check.mjs && node test/preset-check.mjs && node test/env-check.mjs && node test/search-check.mjs"
  }
}
