{
  "name": "dsh-project-panel",
  "version": "0.1.1",
  "description": "DSH 工程面板：把低代码工程目录树搬进 web 端 —— 左栏常驻图标 + 中栏工程浏览器（多级文件树 / 推送状态 / 文件内容）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "工程面板",
    "summary": "把低代码工程目录搬进 DSH Web 侧栏：多级文件树、推送状态账本、源码编辑、推送前静态校验、工程脚本运行，以及空白目录一键开局。",
    "categories": [
      "开发工具",
      "Web UI",
      "低代码"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-0",
      "node": "^22.19.0 || >=24.0.0"
    },
    "permissions": {
      "filesystem": [
        "registered-workspaces"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "scaffold",
    "cordis.patch.yml",
    "README.md",
    "NOTES.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "project-panel",
    "lowcode",
    "magicalcoder",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzqzm/dsh-project-panel.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "build:editor": "esbuild src/editor.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=lib/client.editor.js",
    "watch:editor": "esbuild src/editor.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=lib/client.editor.js --watch"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  },
  "//dependencies": "这一组不是 lib/index.js 自己 import 的，而是插件自带脚手架（scaffold/ 里的 source-*.js）要用的。铺到没有 node_modules 的目录后，靠 NODE_PATH 指到插件这一份复用，省掉每个新目录一次 npm install。版本范围照抄平台下发的 localdev/package.json。",
  "dependencies": {
    "archiver": "^6.0.0",
    "axios": "^1.6.0",
    "form-data": "^4.0.6",
    "unzipper": "^0.10.0"
  }
}
